            <div role="tabpanel" id="panel-tanstack" aria-labelledby="tab-tanstack" data-panel="tanstack" hidden>
              <pre class="code" data-lang="js" tabindex="0" aria-label="tanstack example">import { useQuery } from '@tanstack/react-query';
import { GraphQLClient, gql } from 'graphql-request';

const client = new GraphQLClient('https://graphql-pokeapi.graphcdn.app/');

const query = gql`
  query pokemon($name: String!) {
    pokemon(name: $name) { id name }
  }
`;

const getPokemon = (name) =&gt; client.request(query, { name });

export function Pokemon({ name }) {
  const { data, isPending, error } = useQuery({
    queryKey: ['pokemon', name],
    queryFn: () =&gt; getPokemon(name),
  });

  if (isPending) return 'Loading...';
  if (error) return error.message;

  return data.pokemon.name;
}</pre>
