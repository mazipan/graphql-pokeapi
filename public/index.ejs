    <script>
      (function () {
        'use strict';
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var ENDPOINT = 'https://graphql-pokeapi.graphcdn.app/';

        /* ---------- tiny syntax highlighter ---------- */
        var TOKEN = /("""[\s\S]*?""")|("(?:\\.|[^"\\])*"(\s*:)?)|('(?:\\.|[^'\\])*')|(`[^`]*`)|(\b(?:query|mutation|const|let|await|async|fetch|import|export|from|new|function|return|if|print|true|false|null|curl|True|False|None)\b)|(\b\d+(?:\.\d+)?\b)/g;
        function esc(s) {
          return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }
        function hl(src) {
          return esc(src).replace(TOKEN, function (m, tq, dq, isKey, sq, bt, kw, num) {
            if (tq) return '<span class="tk-str">' + m + '</span>';
            if (dq) return isKey ? '<span class="tk-key">' + dq.slice(0, dq.length - isKey.length) + '</span>' + isKey : '<span class="tk-str">' + dq + '</span>';
            if (sq || bt) return '<span class="tk-str">' + m + '</span>';
            if (kw) return '<span class="tk-kw">' + m + '</span>';
            if (num) return '<span class="tk-num">' + m + '</span>';
            return m;
          });
        }
        function paint(pre) {
          if (pre.getAttribute('data-hl')) return;
          pre.innerHTML = hl(pre.textContent);
          pre.setAttribute('data-hl', '1');
        }
        document.querySelectorAll('[data-panel] pre[data-lang], section#start pre[data-lang]').forEach(paint);

        /* ---------- copy ---------- */
        function copy(text, el) {
          var label = el.querySelector('[data-l]') || el;
          var use = el.querySelector('use');
          var old = label.textContent;
          var done = function () {
            label.textContent = 'Copied';
            if (use) use.setAttribute('href', '#i-check');
            setTimeout(function () {
              label.textContent = old;
              if (use) use.setAttribute('href', '#i-copy');
            }, 1400);
          };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
        }
        document.querySelectorAll('[data-copy]').forEach(function (b) {
          b.addEventListener('click', function () { copy(b.getAttribute('data-copy'), b); });
        });


        /* ---------- small copy key on code blocks ---------- */
        var copyStatus = document.getElementById('copy-status');
        function labelFor(pre) {
          var own = pre.getAttribute('aria-label');
          if (own) return own.toLowerCase();
          var prev = pre.previousElementSibling;
          var text = prev && prev.textContent ? prev.textContent.trim().split(/\s+/)[0] : '';
          return (text || 'code').toLowerCase();
        }
        document.querySelectorAll('pre.code').forEach(function (pre) {
          if (pre.parentElement.hasAttribute('data-panel')) return;
          var what = labelFor(pre);
          var wrap = document.createElement('div');
          wrap.className = 'codewrap';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'codecopy';
          btn.setAttribute('aria-label', 'Copy ' + what);
          btn.innerHTML = '<svg class="ico" aria-hidden="true" focusable="false"><use href="#i-copy" /></svg>';
          btn.addEventListener('click', function () {
            var use = btn.querySelector('use');
            var done = function () {
              use.setAttribute('href', '#i-check');
              btn.classList.add('done');
              copyStatus.textContent = 'Copied ' + what;
              setTimeout(function () {
                use.setAttribute('href', '#i-copy');
                btn.classList.remove('done');
              }, 1400);
            };
            if (navigator.clipboard) navigator.clipboard.writeText(pre.textContent).then(done, function () {});
          });
          wrap.appendChild(btn);
        });

        /* ---------- theme switch ---------- */
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');
        function applyTheme(t, save) {
          root.setAttribute('data-theme', t);
          toggle.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.removeAttribute('media');
            m.setAttribute('content', t === 'dark' ? '#090c15' : '#e9eef8');
          });
          if (save) { try { localStorage.setItem('theme', t); } catch (e) {} }
        }
        applyTheme(root.getAttribute('data-theme') || 'dark', false);
        toggle.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          applyTheme(next, true);
          copyStatus.textContent = (next === 'dark' ? 'Dark' : 'Light') + ' theme on';
        });
        var systemScheme = window.matchMedia('(prefers-color-scheme: light)');
        var onSystem = function (e) {
          var saved = null;
          try { saved = localStorage.getItem('theme'); } catch (err) {}
          if (!saved) applyTheme(e.matches ? 'light' : 'dark', false);
        };
        if (systemScheme.addEventListener) systemScheme.addEventListener('change', onSystem);

        /* ---------- tabs ---------- */
        var tabs = document.querySelectorAll('[data-tab]');
        var panels = document.querySelectorAll('[data-panel]');
        var current = 'fetch';
        var title = document.getElementById('example-title');
        function select(tab, focus) {
          current = tab.getAttribute('data-tab');
          tabs.forEach(function (t) {
            t.setAttribute('aria-selected', String(t === tab));
            t.tabIndex = t === tab ? 0 : -1;
          });
          panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== current; });
          title.textContent = tab.textContent;
          if (focus) tab.focus();
        }
        tabs.forEach(function (tab, i) {
          tab.addEventListener('click', function () { select(tab, false); });
          tab.addEventListener('keydown', function (e) {
            var n = tabs.length, to = -1;
            if (e.key === 'ArrowDown' || e.key === 'ArrowRight') to = (i + 1) % n;
            else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') to = (i - 1 + n) % n;
            else if (e.key === 'Home') to = 0;
            else if (e.key === 'End') to = n - 1;
            if (to > -1) { e.preventDefault(); select(tabs[to], true); }
          });
        });
        var tablist = document.getElementById('example-tabs');
        var wide = window.matchMedia('(min-width: 1024px)');
        function orient() { tablist.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal'); }
        orient();
        if (wide.addEventListener) wide.addEventListener('change', orient);
        document.getElementById('copy-example').addEventListener('click', function (e) {
          copy(document.querySelector('[data-panel="' + current + '"] pre').textContent, e.currentTarget);
        });

        /* ---------- reference index ---------- */
        document.querySelectorAll('#q-list details').forEach(function (d) {
          d.addEventListener('toggle', function () {
            if (d.open) d.querySelectorAll('pre[data-lang]').forEach(paint);
          });
        });
        var input = document.getElementById('q-search');
        var items = document.querySelectorAll('#q-list > li');
        var empty = document.getElementById('q-empty');
        var clearBtn = document.getElementById('q-clear');
        clearBtn.addEventListener('click', function () {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
        });
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          var shown = 0;
          items.forEach(function (li) {
            var hit = !q || li.getAttribute('data-q').indexOf(q) !== -1;
            li.hidden = !hit;
            if (hit) shown++;
          });
          empty.hidden = shown !== 0;
          clearBtn.hidden = !input.value;
          document.getElementById('q-count').textContent = shown + (shown === 1 ? ' query' : ' queries') + ' shown';
        });

        /* ---------- schema map ---------- */
        var NODES = [
          { type: 'Ability', field: 'abilities: [Ability]' },
          { type: 'Move', field: 'moves: [Move]' },
          { type: 'Type', field: 'types: [Type]' },
          { type: 'Stat', field: 'stats: [Stat]' },
          { type: 'Sprite', field: 'sprites: Sprite' },
          { type: 'BaseName', field: 'species: BaseName' },
          { type: 'HeldItem', field: 'held_items: [HeldItem]' },
          { type: 'GameIndex', field: 'game_indices: [GameIndex]' },
        ];
        var map = document.getElementById('map');
        var list = document.getElementById('map-list');
        var NS = 'http://www.w3.org/2000/svg';
        function el(name, attrs, parent) {
          var n = document.createElementNS(NS, name);
          Object.keys(attrs).forEach(function (k) { n.setAttribute(k, attrs[k]); });
          if (parent) parent.appendChild(n);
          return n;
        }
        var defs = el('defs', {}, map);
        function grad(id, a, b, c) {
          var g = el('radialGradient', { id: id, cx: '35%', cy: '28%', r: '78%' }, defs);
          [[0, a], [0.55, b], [1, c]].forEach(function (st) { el('stop', { offset: st[0], style: 'stop-color: ' + st[1] }, g); });
        }
        grad('sg', 'var(--sg-a)', 'var(--sg-b)', 'var(--sg-c)');
        grad('sg-on', 'var(--sgon-a)', 'var(--sgon-b)', 'var(--sgon-c)');
        grad('sg-core', '#9aecff', '#2bb7e6', '#0c5f80');
        var cx = 320, cy = 186, rx = 235, ry = 118;
        var edges = [];
        var nodeEls = [];
        var note = el('text', { x: cx, y: 372, 'text-anchor': 'middle', class: 'mono', style: 'fill: var(--color-muted)', 'font-size': '12' }, map);
        note.textContent = 'pokemon(name: String!): Pokemon';
        NODES.forEach(function (n, i) {
          var a = (Math.PI * 2 * i) / NODES.length - Math.PI / 2;
          n.x = cx + Math.cos(a) * rx;
          n.y = cy + Math.sin(a) * ry;
          edges.push(el('line', { x1: cx, y1: cy, x2: n.x, y2: n.y, class: 'edge' }, map));
        });
        NODES.forEach(function (n, i) {
          var g = el('g', { class: 'node', transform: 'translate(' + n.x + ' ' + n.y + ')' }, map);
          el('circle', { r: 36 }, g);
          el('ellipse', { cx: -9, cy: -19, rx: 17, ry: 8, fill: 'rgba(255,255,255,0.20)', transform: 'rotate(-22)' }, g);
          var t = el('text', { 'text-anchor': 'middle', y: 4 }, g);
          t.textContent = n.type;
          nodeEls.push(g);
          var li = document.createElement('li');
          li.textContent = 'Pokemon links to ' + n.type + ' through ' + n.field;
          list.appendChild(li);
          function on() {
            g.classList.add('on');
            edges[i].classList.add('on');
            note.textContent = n.field;
          }
          function off() {
            g.classList.remove('on');
            edges[i].classList.remove('on');
            note.textContent = 'pokemon(name: String!): Pokemon';
          }
          g.addEventListener('mouseenter', on);
          g.addEventListener('mouseleave', off);
        });
        var center = el('g', { transform: 'translate(' + cx + ' ' + cy + ')' }, map);
        el('circle', { r: 44, fill: 'url(#sg-core)', stroke: '#38d0ff', 'stroke-width': 1.5, style: 'filter: drop-shadow(0 8px 8px rgba(0,0,0,.6))' }, center);
        el('ellipse', { cx: -12, cy: -22, rx: 22, ry: 10, fill: 'rgba(255,255,255,0.30)', transform: 'rotate(-22)' }, center);
        var ct = el('text', { 'text-anchor': 'middle', y: 5, fill: '#031018', 'font-family': 'JetBrains Mono, monospace', 'font-size': 13, 'font-weight': 700 }, center);
        ct.textContent = 'Pokemon';

        /* ---------- query lab ---------- */
        var FIELD = {
          id: 'id',
          name: 'name',
          height: 'height',
          weight: 'weight',
          base_experience: 'base_experience',
          types: 'types { type { name } }',
          stats: 'stats { base_stat stat { name } }',
          sprites: 'sprites { front_default }',
        };
        var ORDER = ['id', 'name', 'height', 'weight', 'base_experience', 'types', 'stats', 'sprites'];
        var REST = { pikachu: 309106, charizard: 373845, mewtwo: 438608, gengar: 364350, eevee: 249004 };
        var restLive = {};
        var who = 'pikachu';
        var checks = document.querySelectorAll('#fields input');
        var qEl = document.getElementById('lab-query');
        var rEl = document.getElementById('lab-response');
        var tEl = document.getElementById('lab-time');
        var spriteEl = document.getElementById('lab-sprite');
        var timer = null;
        var token = 0;
        var userTouched = false;

        function selected() {
          var s = [];
          checks.forEach(function (c) { if (c.checked) s.push(c.value); });
          return ORDER.filter(function (k) { return s.indexOf(k) !== -1; });
        }
        function buildQuery() {
          var f = selected();
          if (!f.length) return '{\n  pokemon(name: "' + who + '") {\n    # tick a field\n  }\n}';
          return '{\n  pokemon(name: "' + who + '") {\n' + f.map(function (k) { return '    ' + FIELD[k]; }).join('\n') + '\n  }\n}';
        }
        function fmt(n) {
          return n >= 1024 ? (n / 1024).toFixed(n >= 102400 ? 0 : 1) + ' KB' : n + ' B';
        }
        function bytes(s) {
          return new Blob([s]).size;
        }
        function render() {
          qEl.innerHTML = hl(buildQuery()).replace(/(# tick a field)/, '<span class="tk-dim">$1</span>');
          document.getElementById('rest-label').textContent = 'REST /pokemon/' + who;
          var rest = restLive[who] || REST[who];
          document.getElementById('rest-size').textContent = fmt(rest);
          document.getElementById('lab-note').textContent = restLive[who]
            ? 'Live requests to both APIs. Sizes are measured in your browser.'
            : 'Live request to this API. The REST size was measured on 2026-11-04.';
        }
        function meter(gqlBytes) {
          var rest = restLive[who] || REST[who];
          document.getElementById('gql-size').textContent = fmt(gqlBytes);
          document.getElementById('gql-bar').style.width = Math.max((gqlBytes / rest) * 100, 0.8) + '%';
          var ratio = Math.round(rest / gqlBytes);
          document.getElementById('lab-ratio').textContent = ratio.toLocaleString('en-US') + 'x';
        }
        function run() {
          var f = selected();
          var my = ++token;
          render();
          if (!f.length) {
            rEl.innerHTML = '<span class="tk-dim">Tick at least one field.</span>';
            tEl.textContent = 'no request';
            spriteEl.classList.add('hidden');
            document.getElementById('gql-size').textContent = '-';
            document.getElementById('gql-bar').style.width = '0%';
            document.getElementById('lab-ratio').textContent = '-';
            return;
          }
          tEl.textContent = 'running';
          var t0 = performance.now();
          fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: buildQuery() }),
          })
            .then(function (r) { return r.text(); })
            .then(function (text) {
              if (my !== token) return;
              var ms = Math.round(performance.now() - t0);
              var json;
              try { json = JSON.parse(text); } catch (e) { throw new Error('bad json'); }
              rEl.innerHTML = hl(JSON.stringify(json, null, 2));
              tEl.textContent = ms + ' ms';
              meter(bytes(text));
              document.getElementById('lab-status').textContent = 'Response in ' + ms + ' milliseconds, ' + bytes(text) + ' bytes, ' + document.getElementById('lab-ratio').textContent + ' smaller than REST.';
              var sp = json && json.data && json.data.pokemon && json.data.pokemon.sprites;
              if (sp && sp.front_default) {
                spriteEl.src = sp.front_default;
                spriteEl.classList.remove('hidden');
              } else {
                spriteEl.classList.add('hidden');
              }
            })
            .catch(function () {
              if (my !== token) return;
              rEl.innerHTML = '<span class="tk-kw">Could not reach the API.</span>\n<span class="tk-dim">Check your connection and change a field to retry.</span>';
              tEl.textContent = 'failed';
            });
        }
        function schedule() {
          clearTimeout(timer);
          timer = setTimeout(run, 220);
        }
        function liveRest(name) {
          if (restLive[name]) return;
          fetch('https://pokeapi.co/api/v2/pokemon/' + name)
            .then(function (r) { return r.arrayBuffer(); })
            .then(function (b) {
              restLive[name] = b.byteLength;
              if (name === who) { render(); schedule(); }
            })
            .catch(function () {});
        }

        checks.forEach(function (c) {
          c.addEventListener('change', function () { userTouched = true; schedule(); });
        });
        document.querySelectorAll('#who .who').forEach(function (b) {
          b.addEventListener('click', function () {
            userTouched = true;
            who = b.getAttribute('data-name');
            document.querySelectorAll('#who .who').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
            liveRest(who);
            schedule();
          });
        });

        /* ---------- Pokémon parallax: each mover eases toward the pointer at its own depth ---------- */
        var movers = Array.prototype.map.call(document.querySelectorAll('.mover'), function (m) {
          return { el: m, d: +m.getAttribute('data-depth'), x: 0, y: 0 };
        });
        var tx = 0, ty = 0, raf = 0;
        function loop() {
          var busy = false;
          movers.forEach(function (m) {
            var gx = tx * m.d, gy = ty * m.d;
            m.x += (gx - m.x) * 0.07;
            m.y += (gy - m.y) * 0.07;
            if (Math.abs(gx - m.x) > 0.05 || Math.abs(gy - m.y) > 0.05) busy = true;
            m.el.style.transform = 'translate3d(' + m.x.toFixed(2) + 'px,' + m.y.toFixed(2) + 'px,0)';
          });
          raf = busy ? requestAnimationFrame(loop) : 0;
        }
        if (!reduce && movers.length && window.matchMedia('(pointer: fine)').matches) {
          window.addEventListener('mousemove', function (e) {
            tx = e.clientX / window.innerWidth - 0.5;
            ty = e.clientY / window.innerHeight - 0.5;
            if (!raf) raf = requestAnimationFrame(loop);
          }, { passive: true });
        }

        render();
        run();
        liveRest(who);

        /* One orchestrated moment: untick fields one by one to show the payload shrink */
        if (!reduce) {
          var drop = ['sprites', 'stats', 'base_experience', 'weight', 'height'];
          var step = 0;
          setTimeout(function tick() {
            if (userTouched || step >= drop.length) return;
            document.querySelector('#fields input[value="' + drop[step] + '"]').checked = false;
            step++;
            schedule();
            setTimeout(tick, 650);
          }, 1800);
        }
      })();
    </script>
  </body>
</html>
