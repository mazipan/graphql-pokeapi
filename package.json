{
  "name": "graphql-pokeapi",
  "description": "GraphQL implementation of pokeapi.co",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "css": "tailwindcss -i public/styles.css -o public/output.css",
    "css:min": "tailwindcss -i public/styles.css -o public/output.min.css --minify",
    "build:html": "ejs public/index.ejs -f public/data.json -o public/index.html",
    "build": "npm run css:min && npm run build:html",
    "serve": "npm run build && serve public",
    "start": "vercel dev",
    "deploy": "vercel --prod",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.4",
    "@vercel/node": "^29.0.1",
    "ejs": "^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "node-fetch": "^2.7.0",
    "pokedex-promise-v2": "^4.2.3",
    "stellate": "^3.2.32",
    "vercel": "^65.11.0",
    "vercel-node-server": "^2.2.1"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix",
    "*.{js,ts,css,md}": "prettier --write"
  },
  "engines": {
    "node": "26.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mazipan/graphql-pokeapi.git"
  },
  "bugs": {
    "url": "https://github.com/mazipan/graphql-pokeapi/issues"
  }
}
